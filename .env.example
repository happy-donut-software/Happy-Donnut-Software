# Happy Donut local development environment

POSTGRES_USER=happydonut
POSTGRES_PASSWORD=change-me-local-postgres

RABBITMQ_USER=happydonut
RABBITMQ_PASS=change-me-local-rabbitmq

APP_DEBUG=false

VENTAS_APP_KEY=base64:replace-with-ventas-key
INVENTARIO_APP_KEY=base64:replace-with-inventario-key
USUARIOS_APP_KEY=base64:replace-with-usuarios-key
FINANZAS_APP_KEY=base64:replace-with-finanzas-key
TIENDA_APP_KEY=base64:replace-with-tienda-key

# Enable domain events from ventas to inventario through RabbitMQ.
MESSAGING_DRIVER=rabbitmq
